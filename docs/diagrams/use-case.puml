@startuml
left to right direction

actor Student
actor Lecturer
actor Administrator

rectangle "EduSurvey System" {

    usecase "Sign In" as UC1

    usecase "View Available Surveys" as UC2
    usecase "Complete Survey" as UC3
    usecase "Submit Survey Response" as UC4
    usecase "View Submission Confirmation" as UC5

    usecase "View Survey Responses" as UC6
    usecase "View Survey Results" as UC7
    usecase "Create Survey" as UC8
    usecase "Edit Survey" as UC9
    usecase "Publish Survey" as UC10

    usecase "Manage Users" as UC11
    usecase "Manage Surveys" as UC12
}

' Student
Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5

' Lecturer
Lecturer --> UC1
Lecturer --> UC6
Lecturer --> UC7
Lecturer --> UC8
Lecturer --> UC9
Lecturer --> UC10

' Administrator
Administrator --> UC1
Administrator --> UC11
Administrator --> UC12

@enduml
