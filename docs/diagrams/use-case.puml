@startuml
left to right direction

title EduSurvey - Use Case Diagram

actor Student
actor Lecturer
actor Administrator

rectangle "EduSurvey System" {

    ' Common
    usecase "Sign In" as UC1
    usecase "Sign Out" as UC2

    ' Student
    usecase "View Available Evaluations\nand Deadlines" as UC3
    usecase "Complete Evaluation" as UC4
    usecase "Submit Evaluation Response" as UC5
    usecase "View Submission\nConfirmation" as UC6
    usecase "Receive Evaluation\nReminder" as UC7

    ' Lecturer
    usecase "Create Evaluation for\nAssigned Course" as UC8
    usecase "Review Feedback" as UC9
    usecase "Group Feedback\nby Topic" as UC10
    usecase "Highlight Common Issues" as UC11
    usecase "View Feedback Statistics" as UC12

    ' Administrator
    usecase "Create Course Evaluation" as UC13
    usecase "Manage Evaluation\nDeadlines" as UC14
    usecase "Manage Users" as UC15
    usecase "Manage Roles" as UC16
    usecase "Manage Evaluations" as UC17
    usecase "Manage System Settings" as UC18
}

' Common authentication
Student --> UC1
Student --> UC2

Lecturer --> UC1
Lecturer --> UC2

Administrator --> UC1
Administrator --> UC2

' Student use cases
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC7

' Student relationships
UC4 ..> UC3 : <<include>>
UC5 ..> UC4 : <<include>>
UC6 ..> UC5 : <<extend>>

' Lecturer use cases
Lecturer --> UC8
Lecturer --> UC9
Lecturer --> UC10
Lecturer --> UC11
Lecturer --> UC12

' Feedback analysis relationships
UC10 ..> UC9 : <<extend>>
UC11 ..> UC9 : <<extend>>
UC12 ..> UC9 : <<extend>>

' Administrator use cases
Administrator --> UC13
Administrator --> UC14
Administrator --> UC15
Administrator --> UC16
Administrator --> UC17
Administrator --> UC18

@enduml